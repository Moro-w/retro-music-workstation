# 复制为 backend/.env 并填写（密钥只进后端，不进仓库）

# ---- 音乐引擎 ----
# 本地 ACE-Step 引擎地址（默认 8001）
ENGINE_BASE_URL=http://localhost:8001
# 引擎选择：auto(优先云API>本地引擎>mock) | falai | acestep | mock | cloud302
MUSIC_PROVIDER=auto

# ---- 云音乐 API（fal.ai 的 CassetteAI music-generator，按次付费）----
FAL_API_KEY=
FAL_MUSIC_MODEL=cassetteai/music-generator

# ---- 云音乐 API（302.AI，封装 Suno/Udio，按次付费，可选）----
MUSIC_API_BASE_URL=https://api.302.ai
MUSIC_API_KEY=

# ---- LLM（OpenAI 兼容，如火山方舟/OpenRouter/DeepSeek，可选）----
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- 服务 ----
DATABASE_URL=sqlite:///./data/app.db
AUDIO_DIR=./data/audio

